# Port for the local HTTPS server. Must match the URL in the Teams app package.
PORT=3001

# Whisper model from Hugging Face (transformers.js / ONNX format).
# Xenova/whisper-tiny.en   fastest, least accurate
# Xenova/whisper-base.en   good default on Apple Silicon
# Xenova/whisper-small.en  more accurate, slower
# Xenova/whisper-base      multilingual
WHISPER_MODEL=Xenova/whisper-base.en

# Public HTTPS URL of this server, used when building the Teams app package.
# Leave unset for https://localhost:3001, or set to a tunnel URL.
# APP_URL=https://localhost:3001
