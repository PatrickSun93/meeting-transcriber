{
  "name": "teams-meeting-transcription",
  "version": "1.0.0",
  "description": "Microsoft Teams meeting tab that transcribes your microphone with a local Whisper model",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "build": "webpack --mode production",
    "certs": "bash scripts/make-certs.sh",
    "package": "node scripts/package-teams-app.js",
    "setup": "npm run build && npm run package",
    "test": "jest",
    "lint": "eslint src scripts tests",
    "format": "prettier --write src scripts tests"
  },
  "keywords": [
    "microsoft-teams",
    "transcription",
    "whisper",
    "speech-to-text",
    "meeting"
  ],
  "author": "Patrick Sun",
  "license": "MIT",
  "dependencies": {
    "@microsoft/teams-js": "^2.19.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^13.4.0",
    "archiver": "^6.0.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "supertest": "^6.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
